{
  "name": "@alieutech/seedsmith",
  "version": "0.3.0",
  "description": "CLI + library to auto-generate seed data for MongoDB (Mongoose) and Prisma with realistic fake data",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alieutech/seedsmith.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "seedsmith": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "test": "jest --config jest.config.cjs --runInBand",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "seed",
    "seeding",
    "mongodb",
    "mongoose",
    "prisma",
    "faker",
    "test-data",
    "fixtures",
    "cli",
    "typescript",
    "orm"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "peerDependencies": {
    "mongoose": "^8.5.2 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
